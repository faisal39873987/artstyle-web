DirectoryIndex index.html
Options -Indexes

<IfModule mod_mime.c>
  AddType text/html .html
  AddType text/css .css
  AddType application/javascript .js .mjs
  AddType application/json .json
  AddType application/manifest+json .webmanifest
  AddType application/xml .xml
  AddType text/plain .txt
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType image/x-icon .ico
  AddType application/octet-stream .nes .fds .sfc .smc .fig .gb .gbc .gba .nds .md .gen .smd .bin .cue .gdi
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header append Vary "Accept-Encoding"

  <FilesMatch "^(index\.html|robots\.txt|sitemap\.xml|site\.webmanifest|sw\.js|public-env\.js)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(css|js|mjs)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(png|jpg|jpeg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>

  <FilesMatch "\.(nes|fds|sfc|smc|fig|gb|gbc|gba|nds|md|gen|smd|bin|cue|gdi|zip)$">
    Header set Cache-Control "private, max-age=0, must-revalidate"
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>

  <Files "sw.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Service-Worker-Allowed "/"
  </Files>
</IfModule>

<IfModule LiteSpeed>
  CacheLookup public on
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json application/manifest+json application/xml image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json application/xml image/svg+xml
</IfModule>

RewriteEngine On
RewriteBase /

ErrorDocument 404 /404.html

RewriteRule (^|/)(\.env.*|\.git(/|$)|composer\.(json|lock)|package(-lock)?\.json|pnpm-lock\.yaml|yarn\.lock)$ - [F,L,NC]

# Static hosting only: there is no local API runtime.
RewriteRule ^api(/.*)?$ - [R=404,L]
RewriteRule ^View.*$ - [R=404,L,NC]
RewriteRule ^assets/all.*game(/.*)?$ - [R=404,L,NC]
RewriteRule ^tools(/.*)?$ - [R=404,L,NC]
RewriteRule ^(docs|images|logo|supabase)(/.*)?$ - [R=404,L,NC]

# No public game-file downloads.
RewriteRule ^roms(/.*)?$ /legal/roms-unavailable.html [R=302,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(assets|config|legal)(/.*)?$ - [R=404,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA fallback for bilingual static pages.
RewriteRule ^ index.html [L]
