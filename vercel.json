{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/roms/:path*",
      "destination": "/legal/roms-unavailable.html",
      "permanent": false
    },
    {
      "source": "/images/covers/:path*",
      "destination": "/legal/roms-unavailable.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/assets/images/:path*",
      "destination": "/images/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*).wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
